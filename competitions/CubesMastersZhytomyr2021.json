d\u0430 \u043d\u0435\u043e\u0444\u0456\u0446\u0456\u0439\u043d\u0430 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0456\u043d\u0430 \u2014 \u0440\u043e\u0437\u0432\u2019\u044f\u0437\u0430\u043d\u043d\u044f \u043a\u0443\u0431\u0438\u043a\u0430 3\u04453\u04453 \u0434\u043b\u044f \u0434\u0456\u0442\u0435\u0439 \u0434\u043e 12 \u0440\u043e\u043a\u0456\u0432.\r\n\u0417\u0430\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c \u043d\u0430 \u0446\u044e \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0456\u043d\u0443 \u043c\u043e\u0436\u043d\u0430 \u0431\u0443\u0434\u0435 \u043d\u0430 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u0445, \u0430\u043b\u0435 \u0434\u0443\u0436\u0435 \u0431\u0430\u0436\u0430\u043d\u0438\u0439 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0456\u0439 \u0437\u0430\u043f\u0438\u0441 \u0437\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043e\u043c +380 63 324 7832.\r\n\u0412\u0430\u0440\u0442\u0456\u0441\u0442\u044c \u0443\u0447\u0430\u0441\u0442\u0456 \u0432 \u043d\u0435\u043e\u0444\u0456\u0446\u0456\u0439\u043d\u0456\u0439 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0456\u043d\u0456 \u2014 30 \u0433\u0440\u043d.\r\n\r\n\u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u043e\u0437\u043d\u0430\u0439\u043e\u043c\u0442\u0435\u0441\u044c \u0437 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u0454\u044e \u043d\u0430 \u0432\u043a\u043b\u0430\u0434\u0446\u0456 COVID-19 \u0434\u043b\u044f \u043f\u0456\u0434\u0432\u0438\u0449\u0435\u043d\u043d\u044f \u0431\u0435\u0437\u043f\u0435\u043a\u0438 \u043d\u0430 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u0445.\r\n\r\n***\r\n\r\nNews regarding Ukrainian Speedcubing are published on our page in [Telegram](https:\/\/t.me\/cubing_info).\r\nDiscussion of the competition will be held in [Telegram](https:\/\/t.me\/joinchat\/D2eJoyBNuE-qxPgJ).\r\n\r\nAt the competition an unofficial event will be held \u2014 solving of 3x3x3 Cube for kids under 12 years.\r\nSigning up for this event will be possible
\u0443\u0431\u0456\u043a\u0430 \u2014 \u043f\u043e\u0434\u0456\u0457, \u044f\u043a\u0430 \u043e\u0431'\u0454\u0434\u043d\u0430\u0454 \u043b\u044e\u0431\u0438\u0442\u0435\u043b\u0456\u0432 \u0441\u043f\u0456\u0434\u043a\u0443\u0431\u0456\u043d\u0433\u0443 \u0437\u0430\u0440\u0430\u0434\u0438 \u0434\u043e\u0431\u0440\u043e\u0457 \u0441\u043f\u0440\u0430\u0432\u0438.\n\u0426\u0435 \u043d\u0435 \u043b\u0438\u0448\u0435 \u043c\u043e\u0436\u043b\u0438\u0432\u0456\u0441\u0442\u044c \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u0441\u0432\u043e\u0457 \u043d\u0430\u0432\u0438\u0447\u043a\u0438, \u043f\u043e\u0437\u043c\u0430\u0433\u0430\u0442\u0438\u0441\u044f \u0437 \u043d\u0430\u0439\u0441\u0438\u043b\u044c\u043d\u0456\u0448\u0438\u043c\u0438 \u0443\u0447\u0430\u0441\u043d\u0438\u043a\u0430\u043c\u0438 \u0442\u0430 \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0447\u0430\u0441 \u0443 \u0434\u0440\u0443\u0436\u043d\u0456\u0439 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0456, \u0430 \u0439 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u0423\u043a\u0440\u0430\u0457\u043d\u0443. \u0420\u0430\u0437\u043e\u043c \u043c\u0438 \u0434\u043e\u0432\u043e\u0434\u0438\u043c\u043e, \u0449\u043e \u043a\u043e\u0436\u0435\u043d \u0440\u0443\u0445 \u043c\u0430\u0454 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f, \u0430 \u0454\u0434\u043d\u0456\u0441\u0442\u044c \u0440\u043e\u0431\u0438\u0442\u044c \u043d\u0430\u0441 \u0441\u0438\u043b\u044c\u043d\u0456\u0448\u0438\u043c\u0438.\n \u0423\u0441\u044f \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0430 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044f \u0449\u043e\u0434\u043e \u0440\u0435\u0454\u0441\u0442\u0440\u0430\u0446\u0456\u0457, \u0440\u043e\u0437\u043a\u043b\u0430\u0434\u0443, \u043f\u0440\u0430\u0432\u0438\u043b, \u043c\u043e\u0436\u043b\u0438\u0432\u0438\u0445 \u0437\u043c\u0456\u043d \u0442\u0430 \u0456\u043d\u0448\u0438\u0445 \u043e\u0440\u0433\u0430\u043d\u0456\u0437\u0430\u0446\u0456\u0439\u043d\u0438\u0445 \u043f\u0438\u0442\u0430\u043d\u044c \u043f\u0443\u0431\u043b\u0456\u043a\u0443\u0432\u0430\u0442\u0438\u043c\u0435\u0442\u044c\u0441\u044f \u0432 Telegram-\u0433\u0440\u0443\u043f\u0456 \u0437\u0430\u0445\u043e\u0434\u0443.\n\u0421\u043a\u043b\u0430\u0434\u0430\u0439 \u0448\u0432\u0438\u0434\u043a\u043e. \u041f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0439 \u0423\u043a\u0440\u0430\u0457\u043d\u0443. \u0420\u0430\u0437\u043e\u043c \u0434\u043e \u043f\u0435\u0440\u0435\u043c\u043e\u0433\u0438! \ud83d\udc99\ud83d\udc9b\n\nSpeed \u200b\u200b\u200b\u200bRubik's Cube Competition in Support of Ukraine \ud83c\uddfa\ud83c\udde6\nWe invite everyone who wants to take part in the speed Rubik's Cube competition - an event that will unite speedcubing enthusiasts for a good cause.\nThis is not only an opportunity to test your skills, compete with the strongest participants and spend time in a friendly atmosphere, but also to support Ukraine. Together we prove that every move matters, and unity makes us stronger.\nAll relevant information regarding registration, schedule, rules, possible changes and other organizational issues will be published in the Telegram group of the event.\nSolve it quickly. Support Ukraine. Together to victory! \ud83d\udc99\ud83d\udc9b","externalWebsite":null}
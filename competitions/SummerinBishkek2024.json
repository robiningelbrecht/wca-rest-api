4\u0434\u0435\u0440\u0436\u043a\u0438 \u043a\u043e\u043c\u0430\u043d\u0434\u044b QBERS.\n10 \u043f\u0440\u043e\u0446\u0435\u0442\u043e\u0432 \u043e\u0442 \u0432\u0441\u0435\u0445 \u0441\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0431\u0443\u0434\u0443\u0442 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044b \u0432 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0443\u044e \u0431\u043b\u0430\u0433\u043e\u0442\u0432\u043e\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044e \"\u0418\u043d\u0442\u0435\u0440\u0430\u043a\u0442\"\n\n\u041a\u044b\u0440\u0433\u044b\u0437\u0447\u0430\nSummer in Bishkek 2024 \u2014 \u0411\u0438\u0448\u043a\u0435\u043a \u0448\u0430\u0430\u0440\u044b\u043d\u0434\u0430 \u04e9\u0442\u04af\u04af\u0447\u04af \u043f\u0430\u0437\u043b\u0434\u0430\u0440\u0434\u044b \u0436\u043e\u0433\u043e\u0440\u043a\u0443 \u044b\u043b\u0434\u0430\u043c\u0434\u044b\u043a\u0442\u0430 \u0447\u043e\u0433\u0443\u043b\u0442\u0443\u0443 \u0431\u043e\u044e\u043d\u0447\u0430 \u0430\u0447\u044b\u043a \u0447\u0435\u043c\u043f\u0438\u043e\u043d\u0430\u0442.\n1 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0430\u0433\u0430 \u043d\u0435\u0433\u0438\u0437\u0433\u0438 \u043a\u0430\u0442\u0442\u043e\u043e \u0442\u04e9\u043b\u04e9\u043c\u04af 200 \u0441\u043e\u043c. 2 \u0436\u0435 \u0430\u043d\u0434\u0430\u043d \u043a\u04e9\u043f \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0430\u043b\u0430\u0440 \u04af\u0447\u04af\u043d \u0442\u04e9\u043b\u04e9\u043c 700 \u0441\u043e\u043c\u0434\u0443 \u0442\u04af\u0437\u04e9\u0442.\n\u0411\u0443\u043b \u043c\u0435\u043b\u0434\u0435\u0448\u0442\u0435\u0440 QBERS \u043a\u043e\u043c\u0430\u043d\u0434\u0430\u0441\u044b\u043d\u044b\u043d \u043a\u043e\u043b\u0434\u043e\u043e\u0441\u0443 \u043c\u0435\u043d\u0435\u043d \u0443\u044e\u0448\u0442\u0443\u0440\u0443\u043b\u0443\u0443\u0434\u0430.\n\u0411\u0430\u0440\u0434\u044b\u043a \u0447\u043e\u0433\u0443\u043b\u0442\u0443\u043b\u0433\u0430\u043d \u043a\u0430\u0440\u0430\u0436\u0430\u0442\u0442\u0430\u0440\u0434\u044b\u043d 10 \u043f\u0430\u0439\u044b\u0437\u044b \"\u0418\u043d\u0442\u0435\u0440\u0430\u043a\u0442\" \u044d\u043b \u0430\u0440\u0430\u043b\u044b\u043a \u043a\u0430\u0439\u0440\u044b\u043c\u0434\u0443\u0443\u043b\u0443\u043a \u0443\u044e\u043c\u0443\u043d\u0430 \u0436\u04e9\u043d\u04e9\u0442\u04af\u043b\u04e9\u0442\n\nEnglish\nSummer in Bishkek 2024 is an open championship in high-speed puzzle assembly in the city of Bishkek.\nThe basic registration fee for 1 discipline is 200 soms. For 2 or more disciplines the fee is 700 soms.\nThese competitions are organized with the support of the QBERS team.\n10 percent of all funds raised will be sent to the international charity organization \"Interact\"","externalWebsite":null}
n\r\n**\u041f\u043e\u043f\u0430\u0434\u0430\u043d\u0438\u0435 \u0432 \u0444\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u0440\u0430\u0443\u043d\u0434\u044b:** \u0414\u043b\u044f \u0442\u0435\u0445 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u043c\u0435\u044e\u0442 \u0431\u043e\u043b\u044c\u0448\u0435 \u043e\u0434\u043d\u043e\u0433\u043e \u0440\u0430\u0443\u043d\u0434\u0430, \u043c\u044b \u0431\u0443\u0434\u0435\u043c \u043d\u0430\u0431\u0438\u0440\u0430\u0442\u044c \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u043c\u0435\u044e\u0442 \u0431\u0435\u043b\u043e\u0440\u0443\u0441\u0441\u043a\u043e\u0435 \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u043e. \u041f\u0440\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043c\u044b \u0431\u0443\u0434\u0435\u043c \u0440\u0430\u0441\u0448\u0438\u0440\u044f\u0442\u044c \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043b\u044e\u0434\u0435\u0439, \u043f\u043e\u043f\u0430\u0434\u0430\u044e\u0449\u0438\u0445 \u0432 \u0444\u0438\u043d\u0430\u043b, \u0434\u043e \u0442\u0435\u0445 \u043f\u043e\u0440, \u043f\u043e\u043a\u0430 \u043d\u0435 \u0431\u0443\u0434\u0435\u0442 \u043d\u0430\u0431\u0440\u0430\u043d\u043e \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u043e\u0432 \u0438\u0437 \u0411\u0435\u043b\u0430\u0440\u0443\u0441\u0438. \u0412 \u043a\u0430\u0436\u0434\u044b\u0439 \u0444\u0438\u043d\u0430\u043b \u043f\u043e\u043f\u0430\u0434\u0443\u0442 \u043c\u0438\u043d\u0438\u043c\u0443\u043c 12 \u0431\u0435\u043b\u043e\u0440\u0443\u0441\u0441\u043a\u0438\u0445 \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u043e\u0432.\r\n\r\n**\u0412\u041d\u0418\u041c\u0410\u041d\u0418\u0415:** \u0422\u0430\u043a \u043a\u0430\u043a \u044d\u0442\u043e \u0427\u0435\u043c\u043f\u0438\u043e\u043d\u0430\u0442 \u0411\u0435\u043b\u0430\u0440\u0443\u0441\u0438, \u0442\u043e \u043f\u0440\u0435\u0442\u0435\u043d\u0434\u043e\u0432\u0430\u0442\u044c \u043d\u0430 \u043f\u0440\u0438\u0437\u044b \u043c\u043e\u0433\u0443\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0435 \u0411\u0435\u043b\u0430\u0440\u0443\u0441\u0438. \u0412 \u0442\u043e \u0436\u0435 \u0432\u0440\u0435\u043c\u044f \u0447\u0435\u043c\u043f\u0438\u043e\u043d\u0430\u0442 \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u043c \u0434\u043b\u044f \u0443\u0447\u0430\u0441\u0442\u0438\u044f \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0435\u0439.","externalWebsite":"https:\/\/vk.com\/club179128194"}
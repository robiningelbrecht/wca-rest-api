u0430\u0435\u0442\u0441\u044f \u0432  \u0441\u0430\u043c\u043e\u043c \u0434\u043e\u0440\u043e\u0433\u043e\u0441\u0442\u043e\u044f\u0449\u0435\u043c \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0435 \u0432 \u043c\u0438\u0440\u0435, ZOLGENSMA.\r\n\r\n\u0413\u043b\u0430\u0432\u043d\u044b\u0439 \u0441\u043f\u043e\u043d\u0441\u043e\u0440 \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u043d\u0438\u044f \u2013 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u044f \u00ab\u041b\u0435\u043e\u0432\u0438\u0442\u00bb. \u0421\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043f\u0440\u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0435 \u0448\u043a\u043e\u043b\u044b \u2116157 \u0438 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0444\u043e\u043d\u0434\u0430 \u00abAlem Asar\u00bb.. \r\n\r\n\u0421\u043c\u043e\u0442\u0440\u0438\u0442\u0435 \u043d\u0430\u0448 \u0430\u043a\u043a\u0430\u0443\u043d\u0442 \u0432 Instagram (https:\/\/instagram.com\/almaty_cubers), \u0447\u0442\u043e\u0431\u044b \u0443\u0437\u043d\u0430\u0432\u0430\u0442\u044c \u043d\u043e\u0432\u043e\u0441\u0442\u0438 \u0438 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0443\u044e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u043e \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u043d\u0438\u0438!\r\n\r\n\u0421\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u0442\u044c \u0432 \u0441\u043f\u043e\u0440\u0442\u0437\u0430\u043b\u0435 \u0448\u043a\u043e\u043b\u044b \u2116157.\r\n\r\n\u0411\u0443\u0434\u0435\u043c \u0440\u0430\u0434\u044b \u0432\u0438\u0434\u0435\u0442\u044c \u0432\u0430\u0441 \u043d\u0430 \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u043d\u0438\u0438! \r\n\r\n\u0416\u0430\u0440\u044b\u0441 \u049b\u0430\u0439\u044b\u0440\u044b\u043c\u0434\u044b\u043b\u044b\u049b \u043c\u0430\u049b\u0441\u0430\u0442\u044b\u043d\u0434\u0430 \u04e9\u0442\u043a\u0456\u0437\u0435\u0434\u0456. \u0416\u0430\u0440\u044b\u0441\u0442\u0430\u043d \u0431\u04af\u043a\u0456\u043b \u0442\u04af\u0441\u043a\u0435\u043d \u049b\u0430\u0440\u0430\u0436\u0430\u0442 \u0441\u043f\u0438\u043d\u0430\u043b\u0434\u044b \u0431\u04b1\u043b\u0448\u044b\u049b \u0430\u0442\u0440\u043e\u0444\u0438\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u044b\u043d\u0430 \u0448\u0430\u043b\u0434\u044b\u049b\u049b\u0430\u043d \u043c\u04af\u0433\u0435\u0434\u0435\u043a\u043a\u0435 3 \u0436\u0430\u0441\u0430\u0440 \u0431\u0430\u043b\u0430 \u0420\u0430\u043c\u0438\u0440 \u041a\u043e\u0432\u0430\u043b\u0435\u0432\u0441\u043a\u0438\u0439\u0433\u0435 \u04d9\u043b\u0435\u043c\u0434\u0435 \u0435\u04a3 \u0431\u0430\u0493\u0430\u043b\u044b \u0434\u04d9\u0440\u0456 \u00abZOLGENSMA\u00bb \u0441\u0430\u0442\u044b\u043f \u0430\u043b\u0443 \u04af\u0448\u0456\u043d \u049b\u0430\u0440\u0436\u044b \u0436\u0438\u043d\u0430\u0443\u0493\u0430 \u0436\u04d9\u043d\u0435 \u043a\u04e9\u043c\u0435\u043a\u0442\u0435\u0441\u0443\u0433\u0435 \u0431\u0430\u0493\u044b\u0442\u0442\u0430\u0439\u0434\u044b\r\n\r\n\u0416\u0430\u0440\u044b\u0441\u0442\u044b\u04a3 \u0431\u0430\u0441 \u0434\u0435\u043c\u0435\u0443\u0448\u0456\u0441\u0456 \u2013 \u00ab\u041b\u0435\u043e\u0432\u0438\u0442\u00bb \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u044f\u0441\u044b. \u0416\u0430\u0440\u044b\u0441 \u043c\u0435\u043a\u0442\u0435\u043f\u0442i\u04a3 \u2116157 \u043c\u0435\u043d \u00abAlem Asar\u00bb \u049b\u043e\u0493\u0430\u043c\u0434\u044b\u049b \u049b\u043e\u0440\u044b\u043d\u044b\u04a3 \u043a\u04e9\u043c\u0435\u0433i\u043c\u0435\u043d \u04e9\u0442\u043ai\u0437\u0456\u043b\u0435\u0434i. \r\n\r\n\u0411\u0456\u0437\u0434\u0456\u04a3 Instagram \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u044b\u043c\u044b\u0437\u0434\u044b\u04a3 \u043f\u0430\u0440\u0430\u049b\u0448\u0430\u0441\u044b\u043d\u0434\u0430 (https:\/\/instagram.com\/almaty_cubers) \u0436\u0430\u04a3\u0430\u043b\u044b\u049b\u0442\u0430\u0440 \u0436\u04d9\u043d\u0435 \u0436\u0430\u0440\u044b\u0441 \u0442\u0443\u0440\u0430\u043b\u044b \u0430\u049b\u043f\u0430\u0440\u0430\u0442 \u043a\u04e9\u0440\u0435 \u0430\u043b\u0430\u0441\u044b\u0437\u0434\u0430\u0440!\r\n\r\n\u0416\u0430\u0440\u044b\u0441 \u043c\u0435\u043a\u0442\u0435\u043f\u0442\u0456\u04a3 \u2116157 \u0441\u043f\u043e\u0440\u0442 \u0437\u0430\u043b\u044b\u043d\u0434\u0430 \u04e9\u0442\u043a\u0456\u0437\u0456\u043b\u0435\u0434\u0456.\r\n\r\n\u0421\u0456\u0437\u0434\u0456\u04a3 \u0436\u0430\u0440\u044b\u0441\u049b\u0430 \u0431\u0435\u043b\u0441\u0435\u043d\u0434\u0456 \u0430\u0442 \u0441\u0430\u043b\u044b\u0441\u044b\u043f \u049b\u0430\u0442\u044b\u0441\u049b\u0430\u043d\u044b\u04a3\u044b\u0437\u0493\u0430 \u049b\u0443\u0430\u043d\u044b\u0448\u0442\u044b\u043c\u044b\u0437! \r\n\r\n\r\n \r\nThe competition is organised for charity. All the proceeds made from the competition will be spent for fundraising for helping 3-years old kid, Ramir Kovalevsky, in his spinal muscular atrophy medical treatment to purchase him the most expensive cure in the world, ZOLGENSMA.\r\n\r\nThe Leovit company is the main sponsor of the competition. The competition is organised with the help of school #157 and Alem Asar social foundation.\r\n\r\nWatch our posts in our Instagram account (https:\/\/instagram.com\/almaty_cubers) to learn the news and more information about the competition! \r\n\r\nThe competition will be set in the sports hall of the school #157.\r\n\r\nWe will be happy to see you at the competition!","externalWebsite":null}
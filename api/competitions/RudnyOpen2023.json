34\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 3500 \u0442\u0435\u043d\u0433\u0435, \u043f\u0440\u0438 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u043d\u0430 \u043c\u0435\u0441\u0442\u0435 - 4000 \u0442\u0435\u043d\u0433\u0435. \u041f\u0440\u0438 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u043d\u0430 1 \u043b\u044e\u0431\u0443\u044e \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0443 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0432\u0437\u043d\u043e\u0441 \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u0442 1000 \u0442\u0435\u043d\u0433\u0435, \u043d\u0430 \u043c\u0435\u0441\u0442\u0435 - 1500 \u0442\u0435\u043d\u0433\u0435. Rudny Open - \u044d\u0442\u043e \u043f\u0435\u0440\u0432\u044b\u0435 \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0431\u0443\u0434\u0443\u0442 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u044b \u043a\u043e\u043c\u0430\u043d\u0434\u043e\u0439 QBERS.\r\n\r\n**\u049a\u0430\u0437\u0430\u049b\u0448\u0430**\r\n\r\n\u041e\u0441\u044b \u0430\u0448\u044b\u049b \u0445\u0430\u043b\u044b\u049b\u0430\u0440\u0430\u043b\u044b\u049b \u0447\u0435\u043c\u043f\u0438\u043e\u043d\u0430\u0442 - \u049a\u043e\u0441\u0442\u0430\u043d\u0430\u0439 \u043e\u0431\u043b\u044b\u0441\u044b\u043d\u0434\u0430\u0493\u044b \u0435\u04a3 \u0431\u0456\u0440\u0456\u043d\u0448\u0456 \u0440\u0435\u0441\u043c\u0438 \u0436\u0430\u0440\u044b\u0441. \u041f\u04d9\u043d\u0434\u0435\u0440\u0434\u0456\u04a3 \u043a\u0435\u0437 \u043a\u0435\u043b\u0433\u0435\u043d \u0441\u0430\u043d\u044b\u043d\u0430 \u049b\u0430\u0442\u044b\u0441\u0443 \u0430\u049b\u044b\u0441\u044b - 3500 \u0442\u0435\u04a3\u0433\u0435, \u04e9\u0442\u043a\u0456\u0437\u0456\u043b\u0443 \u043e\u0440\u044b\u043d\u044b\u043d\u0434\u0430 \u0442\u0456\u0440\u043a\u0435\u043b\u0433\u0435\u043d \u043a\u0435\u0437\u0434\u0435 - 4000 \u0442\u0435\u04a3\u0433\u0435. \u041a\u0435\u0437 \u043a\u0435\u043b\u0433\u0435\u043d \u0431\u0456\u0440 \u043f\u04d9\u043d\u0433\u0435 \u049b\u0430\u0442\u044b\u0441\u0443 \u0430\u049b\u044b\u0441\u044b - 1000 \u0442\u0435\u04a3\u0433\u0435, \u04e9\u0442\u043a\u0456\u0437\u0456\u043b\u0443 \u043e\u0440\u044b\u043d\u044b\u043d\u0434\u0430 \u0442\u0456\u0440\u043a\u0435\u043b\u0433\u0435\u043d \u043a\u0435\u0437\u0434\u0435 - 1500 \u0442\u0435\u04a3\u0433\u0435. Rudny Open - QBERS \u049b\u04b1\u0440\u0430\u043c\u0430\u0441\u044b \u04b1\u0439\u044b\u043c\u0434\u0430\u0441\u0442\u044b\u0440\u0430\u0442\u044b\u043d \u0430\u043b\u0493\u0430\u0448\u049b\u044b \u0436\u0430\u0440\u044b\u0441.\r\n\r\n**English**\r\n\r\nThis championship is the first-ever official competition in the Kostanay region. The base registration fee for any number of events is 3500 tenge. It's 4000 tenge when registering on the spot. If you're participating in 1 event only, the registration fee is 1000 tenge. It will be 1500 tenge when registering on the spot. Rudny Open is going to be the first competition organized by the QBERS team.\r\n\r\n","externalWebsite":null}
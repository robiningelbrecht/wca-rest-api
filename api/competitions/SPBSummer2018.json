3e\u0431\u043e\u0434\u043d\u044b\u0439.\r\n\r\n\u0420\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044f \u0431\u0443\u0434\u0435\u0442 \u0437\u0430\u043a\u0440\u044b\u0442\u0430 28 \u0438\u044e\u043b\u044f \u0438\u043b\u0438 \u043a\u043e\u0433\u0434\u0430 \u0431\u0443\u0434\u0443\u0442 \u043e\u0434\u043e\u0431\u0440\u0435\u043d\u044b \u043f\u0435\u0440\u0432\u044b\u0435 220 \u043e\u043f\u043b\u0430\u0447\u0435\u043d\u043d\u044b\u0445 \u0437\u0430\u044f\u0432\u043e\u043a. \u0427\u0442\u043e\u0431\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u0435 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438, \u043f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435 \u043d\u0430\u0448\u0443 [\u0433\u0440\u0443\u043f\u043f\u0443 \u0412\u041a\u043e\u043d\u0442\u0430\u043a\u0442\u0435](https:\/\/vk.com\/spbsummer18).\r\n\r\n**\u0412\u041d\u0418\u041c\u0410\u041d\u0418\u0415!** \u041f\u0435\u0440\u0435\u0434 \u043f\u043e\u0434\u0430\u0447\u0435\u0439 \u0437\u0430\u044f\u0432\u043a\u0438 \u043f\u0440\u043e\u0447\u0442\u0438\u0442\u0435 \u0432\u0430\u0436\u043d\u0443\u044e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u0432 \u0440\u0430\u0437\u0434\u0435\u043b\u0435 \"\u0422\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f \u043a \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438\".\r\n\r\n--\r\nAnybody can participate in competition whatever the age, gender or solving results. \r\n\r\nRegistration will be closed on July 28th or when we accept 220 paid applications. Participation fee: 350 rubles for any 4 events, +10 rub for each next event. Spectators are welcome and do not need to pay or register. Check out the tabs for more information!\r\n\r\nPlease read \"Registration requirements\" before sending your application.","externalWebsite":"https:\/\/vk.com\/spbsummer18"}
0642\u0627\u0645 \u0647\u0630\u0647 \u0627\u0644\u0645\u0633\u0627\u0628\u0642\u0629 \u0639\u0644\u0649 \u0645\u062f\u0627\u0631 \u064a\u0648\u0645\u064a\u0646\u060c \u0645\u0639 \u0627\u0644\u0639\u062f\u064a\u062f \u0645\u0646 \u0627\u0644\u0641\u0639\u0627\u0644\u064a\u0627\u062a \u0627\u0644\u062c\u0627\u0646\u0628\u064a\u0629 \u064a\u0648\u0645 \u0627\u0644\u062c\u0645\u0639\u0629 \u0648\u0641\u0639\u0627\u0644\u064a\u0627\u062a \u0623\u0643\u062b\u0631 \u0634\u0639\u0628\u064a\u0629 \u064a\u0648\u0645 \u0627\u0644\u0633\u0628\u062a. \u0644\u064a\u0633 \u0639\u0644\u064a\u0643\u0645 \u062d\u0636\u0648\u0631 \u0643\u0644\u0627 \u0627\u0644\u064a\u0648\u0645\u064a\u0646\u060c \u0641\u0642\u0637 \u064a\u0648\u0645 \u0627\u0644\u0641\u0639\u0627\u0644\u064a\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0631\u063a\u0628\u0648\u0646 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629 \u0641\u064a\u0647\u0627.\n\u064a\u0631\u062c\u0649 \u0645\u0631\u0627\u062c\u0639\u0629 \u0623\u0642\u0633\u0627\u0645 **\u0627\u0644\u0641\u0639\u0627\u0644\u064a\u0627\u062a\u060c \u0648\u0627\u0644\u062c\u062f\u0648\u0644 \u0627\u0644\u0632\u0645\u0646\u064a\u060c \u0648\u0627\u0644\u0645\u062a\u0633\u0627\u0628\u0642\u064a\u0646 \u0627\u0644\u062c\u062f\u062f\u060c \u0648\u0627\u0644\u0645\u062a\u0637\u0648\u0639\u064a\u0646** \u0628\u0639\u0646\u0627\u064a\u0629 \u0644\u0644\u062a\u0623\u0643\u062f \u0645\u0646 \u0645\u0639\u0631\u0641\u0629 \u0643\u0644 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0647\u0627\u0645\u0629.","externalWebsite":null}